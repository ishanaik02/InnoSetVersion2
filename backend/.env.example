PORT=5000
MONGO_URI=mongodb://localhost:27017/service_engineer_trips
USE_MEMORY_DB=false

# Generate a fresh one — do NOT reuse this file's value or any value that has
# ever been committed to version control:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_freshly_generated_64_byte_hex_secret

# Comma-separated list of origins allowed to call this API (no trailing slash).
# The Expo/React Native app itself isn't subject to CORS, but any web admin
# console or browser-based tool you point at this API needs its origin listed
# here.
CORS_ALLOWED_ORIGINS=http://localhost:19006,http://localhost:8081
